<div class="overflow-x-auto margin-auto">
  <div align="center" class="mt-8 pt-4">
    <ul class="steps">
      <li class="step step-neutral"><%= I18n.t('steps.choose_plan') %></li>
      <li class="step step-neutral"><%= I18n.t('steps.register') %></li>
      <li class="step step-neutral"><%= I18n.t('steps.validate') %></li>
      <li class="step step-neutral"><%= I18n.t('steps.complete') %></li>
    </ul>
    <div class="m-10">
      <div role="alert" class="alert card bg-white text-black shadow-sm">
        <%= render(partial: "icons/valid") %>
        <div class="m-2">
          <p><%= I18n.t('confirmation.text_1') %></p>
          <p><%= I18n.t('confirmation.text_2') %></p>
          <p><%= I18n.t('confirmation.text_3') %></p>
        </div>
      </div>
    </div>
  </div>
</div>
