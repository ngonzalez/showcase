<form class="overflow-x-auto"
      style="margin: auto;"
      id="registerForm"
      data-controller="register"
      data-register-target="registerForm">

  <ul class="steps">
    <li class="step step-neutral">
      <%= link_to "Choose Plan", plans_path, style: "text-decoration: underline;" %>
    </li>
    <li class="step step-neutral">
      <%= link_to "Register", register_path(plan: @plan), style: "text-decoration: underline;" %>
    </li>
    <li class="step">Validate</li>
    <li class="step">Complete</li>
  </ul>

  <table class="table">
    <thead>
      <tr>
        <th>
        </th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td align="center" class="w-96">
          <table>
            <tr>
              <td>
                <input data-action="input->register#radioSelect"
                       type="radio"
                       name="user[accountType]"
                       value="person"
                       class="radio radio-info" />
                <label data-action="click->register#labelClicked"
                       for="user[accountType]"
                       class="label">Person</label>
              </td>
              <td>
                <!-- -->
              </td>
              <td>
                <input data-action="input->register#radioSelect"
                       type="radio"
                       name="user[accountType]"
                       value="company"
                       class="radio radio-info"
                       checked="checked" />
                <label data-action="click->register#labelClicked"
                       for="user[accountType]"
                       class="label">Company</label>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Last Name -->
          <label class="w-96 input validator" for="user[companyName]">
            <span class="label white-rounded">
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M18 15h-2v2h2m0-6h-2v2h2m2 6h-8v-2h2v-2h-2v-2h2v-2h-2V9h8M10 7H8V5h2m0 6H8V9h2m0 6H8v-2h2m0 6H8v-2h2M6 7H4V5h2m0 6H4V9h2m0 6H4v-2h2m0 6H4v-2h2m6-10V3H2v18h20V7z"/></svg>
              Company name
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[companyName]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z][A-Za-z0-9\-]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- First Name -->
          <label class="w-96 input validator" for="user[firstName]">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </g>
              </svg>
              First name
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[firstName]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z][A-Za-z0-9\-]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
          <div class="validator-hint hidden">Enter a valid first name</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Last Name -->
          <label class="w-96 input validator" for="user[lastName]">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </g>
              </svg>
              Last name
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[lastName]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z][A-Za-z0-9\-]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
          <div class="validator-hint hidden">Enter a valid last name</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Email Address -->
          <label class="w-96 input validator" for="user[emailAddress]">
            <span class="label white-rounded">
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none"><path fill="currentColor" d="M3 5v-.5a.5.5 0 0 0-.5.5zm18 0h.5a.5.5 0 0 0-.5-.5zM3 5.5h18v-1H3zM20.5 5v12h1V5zM19 18.5H5v1h14zM3.5 17V5h-1v12zM5 18.5A1.5 1.5 0 0 1 3.5 17h-1A2.5 2.5 0 0 0 5 19.5zM20.5 17a1.5 1.5 0 0 1-1.5 1.5v1a2.5 2.5 0 0 0 2.5-2.5z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m3 5l9 9l9-9"/></g></svg>
              Email address
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[emailAddress]"
                   type="email"
                   placeholder="mail@site.com" />
          </label>
          <div class="validator-hint hidden">Enter a valid email address</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Address -->
          <textarea data-action="input->register#input"
                    required
                    name="user[address]"
                    class="w-96 textarea"
                    pattern="[A-Za-z][A-Za-z0-9\- ]*"
                    title="Only letters, numbers or dash"
                    placeholder="Address: 123 Jane Doe st."></textarea>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Last Name -->
          <label class="w-96 input validator" for="user[postalCode]">
            <span class="label white-rounded">
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 10a1 1 0 0 0-16 0q0 6 8 12q8-6 8-12"/></svg>
              Postal code
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[postalCode]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z0-9][A-Za-z0-9\- ]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
          <div class="validator-hint hidden">Enter a valid postal code</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Last Name -->
          <label class="w-96 input validator" for="user[city]">
            <span class="label white-rounded">
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M21 5.5v14h2V21H1v-1.5h2V4.32l3.75-2.19l3.75 2.19V12h3V5.5zM19.5 7H15v5h3v7.5h1.5zm-9 6.5v6h6v-6zM6.75 3.87L4.5 5.18V19.5H9V5.18zM6 9V7h1.5v2zm0 1.5v2h1.5v-2zM6 16v-2h1.5v2zm12-7.5h-1.5v2H18zm-6 8V15h3v1.5z" clip-rule="evenodd"/></svg>
              City
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[city]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z][A-Za-z0-9\- ]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
          <div class="validator-hint hidden">Enter a valid city</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="w-96 select validator" for="user[country]">
            <span class="label white-rounded">
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor"><path d="m19.5 6l-1.467 1.1a2 2 0 0 1-1.2.4h-3.358a1.578 1.578 0 0 0-.999 2.799l2 1.636a6 6 0 0 1 2.164 5.306l-.02.18a8 8 0 0 1-.523 2.087L15.5 21m-13-10.5l3.238-.54a2 2 0 0 1 2.302 2.302l-.135.807a3.34 3.34 0 0 0 1.8 3.533a2.5 2.5 0 0 1 1.308 2.846L10.5 21.5"/><circle cx="12" cy="12" r="9.5"/></g></svg>
            Country
            </span>
            <select data-action="change->register#input"
                    required
                    name="user[country]"
                    class="select select-neutral">
              <option disabled selected></option>
              <option>France</option>
              <option>United States</option>
              <option>Canada</option>
            </select>
          </label>
          <div class="validator-hint hidden">Select a valid country</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="w-96 select validator" for="user[plan]">
            <span class="label white-rounded">
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 48 48"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m7.369 28.832l30.755-5.516l5.376-9.143l-8.245-5.958L4.5 13.73z"/><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="m10.494 28.272l7.997 11.513l23.522-15.73l1.487-9.882"/><circle cx="39.339" cy="14.912" r=".75" fill="currentColor"/></svg>
            Plan
            </span>
            <select data-action="change->register#input"
                    required
                    name="user[plan]"
                    class="select select-neutral">
              <%= options_for_select(
                {
                  "Premium #{@plan}" => @plan,
                },
                @plan
              ) %>
            </select>
          </label>
          <div class="validator-hint hidden">Select a valid plan</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="w-96 input validator">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <path
                    d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"
                  ></path>
                  <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
                </g>
              </svg>
              Password
            </span>
            <input data-action="change->register#input"
                   required
                   name="user[password]"
                   type="password"
                   placeholder="Password"
                   minlength="8"
                   pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                   title="Must be more than 8 characters, including number, lowercase letter, uppercase letter"
            />
          </label>
          <p class="validator-hint hidden">
            Must be more than 8 characters, including
            <br />At least one number <br />At least one lowercase letter <br />At least one uppercase letter
          </p>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="w-96 input validator">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <path
                    d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"
                  ></path>
                  <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
                </g>
              </svg>
              Password confirmation
            </span>
            <input data-action="change->register#input"
                   required
                   name="user[passwordConfirmation]"
                   type="password"
                   placeholder="Password confirmation"
                   minlength="8"
                   pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                   title="Must be more than 8 characters, including number, lowercase letter, uppercase letter" />
          </label>
          <p class="validator-hint hidden">
            Must be more than 8 characters, including
            <br />At least one number <br />At least one lowercase letter <br />At least one uppercase letter
          </p>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="label">
            <input data-action="change->register#inputChanged"
                   required
                   name="user[agreeToTermsAndConditions]"
                   type="checkbox"
                   class="checkbox" />
            I have read and accept the terms and conditions
          </label>
        </td>
      </tr>
      <tr>
        <td align="center">
          <input data-action="click->register#submit"
                 name="submitButton"
                 type="submit"
                 class="btn" />
        </td>
      </tr>
    </tbody>
  </table>
</form>

<style type="text/css">
  label {
    color: #000 !important;
  }
  .white-rounded {
    background: #FEFEFE;
    border-radius: 20px;
  }
</style>
