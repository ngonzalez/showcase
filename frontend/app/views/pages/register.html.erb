<div style="margin: auto;" class="overflow-x-auto">
  <div align="center" class="mt-8 pt-4">
    <ul class="steps">
      <li class="step step-neutral">
        <%= link_to I18n.t('steps.choose_plan'),
              plans_path,
              style: "text-decoration: underline;" %>
      </li>
      <li class="step step-neutral"><%= I18n.t('steps.register') %></li>
      <li class="step"><%= I18n.t('steps.validate') %></li>
      <li class="step"><%= I18n.t('steps.complete') %></li>
    </ul>
    <%= form_with(method: :post,
                  url: registration_path,
                  id: "registerForm",
                  data: { turbo: true },
                  html: {
                    data: {
                      controller: "register",
                      "register-target": "registerForm"
                    }
                  }) do |_form| %>
      <table class="table">
        <thead>
          <tr>
            <th>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td align="center" class="w-96">
              <table>
                <tr>
                  <td>
                    <input data-action="input->register#radioSelect"
                           type="radio"
                           name="user[accountType]"
                           value="person"
                           class="radio radio-neutral" />
                    <label data-action="click->register#labelClicked"
                           for="user[accountType]"
                           class="label"><%= I18n.t('form.register.person') %></label>
                  </td>
                  <td>
                    <!-- -->
                  </td>
                  <td>
                    <input data-action="input->register#radioSelect"
                           type="radio"
                           name="user[accountType]"
                           value="company"
                           class="radio radio-neutral"
                           checked="checked" />
                    <label data-action="click->register#labelClicked"
                           for="user[accountType]"
                           class="label"><%= I18n.t('form.register.company') %></label>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Company Name -->
              <label class="w-96 input validator" for="user[companyName]">
                <span class="label white-rounded">
                  <%= render(partial: "icons/account") %>
                  <%= I18n.t('form.register.company_name') %>
                </span>
                <input data-action="input->register#input"
                       required
                       name="user[companyName]"
                       type="text"
                       class="input"
                       pattern="[A-Za-z][A-Za-z0-9\-]*"
                       minlength="3"
                       maxlength="30"
                       title="<%= I18n.t('validation.allowed_values_message') %>" />
              </label>
              <div class="validator-hint hidden">
                <%= I18n.t('form.register.company_name') %>
              </div>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- First Name -->
              <label class="w-96 input validator" for="user[firstName]">
                <span class="label white-rounded">
                  <%= render(partial: "icons/account") %>
                  <%= I18n.t('form.register.first_name') %>
                </span>
                <input data-action="input->register#input"
                       required
                       name="user[firstName]"
                       type="text"
                       class="input"
                       pattern="[A-Za-z][A-Za-z0-9\-]*"
                       minlength="3"
                       maxlength="30"
                       title="Only letters, numbers or dash" />
              </label>
              <div class="validator-hint hidden">
                <%= I18n.t('validation.register.first_name') %>
              </div>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Last Name -->
              <label class="w-96 input validator" for="user[lastName]">
                <span class="label white-rounded">
                  <%= render(partial: "icons/account") %>
                  <%= I18n.t('form.register.last_name') %>
                </span>
                <input data-action="input->register#input"
                       required
                       name="user[lastName]"
                       type="text"
                       class="input"
                       pattern="[A-Za-z][A-Za-z0-9\-]*"
                       minlength="3"
                       maxlength="30"
                       title="Only letters, numbers or dash" />
              </label>
              <div class="validator-hint hidden">
                <%= I18n.t('validation.register.last_name') %>
              </div>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Email Address -->
              <label class="w-96 input validator" for="user[emailAddress]">
                <span class="label white-rounded">
                  <%= render(partial: "icons/mail") %>
                  <%= I18n.t('form.register.email_address') %>
                </span>
                <input data-action="input->register#input"
                       required
                       name="user[emailAddress]"
                       type="email"
                       placeholder="<%= I18n.t('form.register.email_address_placeholder') %>" />
              </label>
              <div class="validator-hint hidden">
                <%= I18n.t('validation.register.email_address') %>
              </div>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Address -->
              <textarea data-action="input->register#input"
                        required
                        name="user[address]"
                        class="w-96 textarea"
                        pattern="[A-Za-z][A-Za-z0-9\- ]*"
                        title="<%= I18n.t('validation.allowed_values_message') %>"
                        placeholder="<%= I18n.t('form.register.address_placeholder') %>"></textarea>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Postal Code -->
              <label class="w-96 input validator" for="user[postalCode]">
                <span class="label white-rounded">
                  <%= render(partial: "icons/postal_code") %>
                  <%= I18n.t('form.register.postal_code') %>
                </span>
                <input data-action="input->register#input"
                       required
                       name="user[postalCode]"
                       type="text"
                       class="input"
                       pattern="[A-Za-z0-9][A-Za-z0-9\- ]*"
                       minlength="3"
                       maxlength="30"
                       title="<%= I18n.t('validation.allowed_values_message') %>" />
              </label>
              <div class="validator-hint hidden">
                <%= I18n.t('validation.register.postal_code') %>
              </div>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- City -->
              <label class="w-96 input validator" for="user[city]">
                <span class="label white-rounded">
                  <%= render(partial: "icons/city") %>
                  <%= I18n.t('form.register.city') %>
                </span>
                <input data-action="input->register#input"
                       required
                       name="user[city]"
                       type="text"
                       class="input"
                       pattern="[A-Za-z][A-Za-z0-9\- ]*"
                       minlength="3"
                       maxlength="30"
                       title="<%= I18n.t('validation.allowed_values_message') %>" />
              </label>
              <div class="validator-hint hidden">
                <%= I18n.t('validation.register.city') %>
              </div>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Country -->
              <label class="w-96 select validator" for="user[country]">
                <span class="label white-rounded">
                  <%= render(partial: "icons/world") %>
                  <%= I18n.t('form.register.country') %>
                </span>
                <select data-action="change->register#input"
                        required
                        name="user[country]"
                        class="select select-neutral">
                  <option disabled selected></option>
                  <option>France</option>
                  <option>United States</option>
                  <option>Canada</option>
                </select>
              </label>
              <div class="validator-hint hidden">
                <%= I18n.t('validation.register.country') %>
              </div>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Plan -->
              <label class="w-96 select validator" for="user[plan]">
                <span class="label white-rounded">
                  <%= render(partial: "icons/tag") %>
                  <%= I18n.t('form.register.plan') %>
                </span>
                <%= render(partial: "icons/password") %>
                <select data-action="change->register#input"
                        required
                        name="user[plan]"
                        class="select select-neutral">
                  <%= options_for_select(
                    {
                      "Premium #{@plan}" => @plan,
                    },
                    @plan
                  ) %>
                </select>
              </label>
              <div class="validator-hint hidden">
                <%= I18n.t('validation.register.plan') %>
              </div>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Password -->
              <label class="w-96 input validator">
                <span class="label white-rounded">
                  <%= render(partial: "icons/password") %>
                  <%= I18n.t('form.register.password') %>
                </span>
                <input data-action="change->register#input"
                       required
                       name="user[password]"
                       type="password"
                       placeholder="<%= I18n.t('form.register.password') %>"
                       minlength="8"
                       pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                       title="<%= I18n.t('validation.allowed_values_password') %>"
                />
              </label>
              <p class="validator-hint hidden">
                <%= I18n.t('validation.allowed_values_password_long').html_safe %>
              </p>
            </td>
          </tr>
          <tr>
            <td align="center">
              <!-- Password confirmation -->
              <label class="w-96 input validator">
                <span class="label white-rounded">
                  <%= render(partial: "icons/password") %>
                  <%= I18n.t('form.register.password_confirmation') %>
                </span>
                <input data-action="change->register#input"
                       required
                       name="user[passwordConfirmation]"
                       type="password"
                       placeholder="<%= I18n.t('form.register.password_confirmation') %>"
                       minlength="8"
                       pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                       title="<%= I18n.t('validation.allowed_values_password') %>" />
              </label>
              <p class="validator-hint hidden">
                <%= I18n.t('validation.allowed_values_password_long').html_safe %>
              </p>
            </td>
          </tr>
          <tr>
            <td align="center">
              <label class="label">
                <input data-action="change->register#inputChanged"
                       required
                       name="user[agreeToTermsAndConditions]"
                       type="checkbox"
                       class="checkbox" />
                <%= I18n.t('form.register.terms_and_conditions') %>
              </label>
            </td>
          </tr>
          <tr>
            <td align="center">
              <input data-action="click->register#submit"
                     type="submit"
                     class="btn" />
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
<style type="text/css">
  label {
    color: #000 !important;
  }
  .white-rounded {
    background: #FEFEFE;
    border-radius: 20px;
  }
</style>
