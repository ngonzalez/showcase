<form class="overflow-x-auto"
      style="margin: auto;"
      id="registerForm"
      data-controller="register"
      data-register-target="registerForm">

  <ul class="steps">
    <li class="step step-neutral">
      <%= link_to "Choose Plan", plans_path, style: "text-decoration: underline;" %>
    </li>
    <li class="step step-neutral">
      <%= link_to "Register", register_path(plan: @plan), style: "text-decoration: underline;" %>
    </li>
    <li class="step">Validate</li>
    <li class="step">Complete</li>
  </ul>

  <table class="table">
    <thead>
      <tr>
        <th>
        </th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td align="center">
          <!-- First Name -->
          <label class="w-96 input validator" for="user[first_name]">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </g>
              </svg>
              First name
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[firstName]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z][A-Za-z0-9\-]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
          <div class="validator-hint hidden">Enter a valid first name</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Last Name -->
          <label class="w-96 input validator" for="user[last_name]">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </g>
              </svg>
              Last name
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[lastName]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z][A-Za-z0-9\-]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
          <div class="validator-hint hidden">Enter a valid last name</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Email Address -->
          <label class="w-96 input validator">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </g>
              </svg>
              Email address
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[emailAddress]"
                   type="email"
                   placeholder="mail@site.com" />
          </label>
          <div class="validator-hint hidden">Enter a valid email address</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Address -->
          <textarea data-action="input->register#input"
                    required
                    name="user[address]"
                    class="w-96 textarea"
                    pattern="[A-Za-z][A-Za-z0-9\- ]*"
                    title="Only letters, numbers or dash"
                    placeholder="Address: 123 Jane Doe st."></textarea>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Last Name -->
          <label class="w-96 input validator" for="user[postalCode]">
            <span class="label white-rounded">
              Postal code
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[postalCode]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z0-9][A-Za-z0-9\- ]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
          <div class="validator-hint hidden">Enter a valid postal code</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <!-- Last Name -->
          <label class="w-96 input validator" for="user[city]">
            <span class="label white-rounded">
              City
            </span>
            <input data-action="input->register#input"
                   required
                   name="user[city]"
                   type="text"
                   class="input"
                   pattern="[A-Za-z][A-Za-z0-9\- ]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
          </label>
          <div class="validator-hint hidden">Enter a valid city</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="w-96 select validator" for="user[country]">
            <span class="label white-rounded">
            Country
            </span>
            <select data-action="change->register#input"
                    required
                    name="user[country]"
                    class="select select-neutral">
              <option disabled selected></option>
              <option>France</option>
              <option>United States</option>
              <option>Canada</option>
            </select>
          </label>
          <div class="validator-hint hidden">Select a valid country</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="w-96 select validator" for="user[plan]">
            <span class="label white-rounded">
            Plan
            </span>
            <select data-action="change->register#input"
                    required
                    name="user[plan]"
                    class="select select-neutral">
              <%= options_for_select(
                {
                  "Premium #{@plan}" => @plan,
                },
                @plan
              ) %>
            </select>
          </label>
          <div class="validator-hint hidden">Select a valid plan</div>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="w-96 input validator">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <path
                    d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"
                  ></path>
                  <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
                </g>
              </svg>
              Password
            </span>
            <input
              data-action="change->register#input"
              required
              name="user[password]"
              type="password"
              placeholder="Password"
              minlength="8"
              pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
              title="Must be more than 8 characters, including number, lowercase letter, uppercase letter"
            />
          </label>
          <p class="validator-hint hidden">
            Must be more than 8 characters, including
            <br />At least one number <br />At least one lowercase letter <br />At least one uppercase letter
          </p>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="w-96 input validator">
            <span class="label white-rounded">
              <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  stroke-width="2.5"
                  fill="none"
                  stroke="currentColor">
                  <path
                    d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"
                  ></path>
                  <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
                </g>
              </svg>
              Password confirmation
            </span>
            <input
              data-action="change->register#input"
              required
              name="user[passwordConfirmation]"
              type="password"
              placeholder="Password Confirmation"
              minlength="8"
              pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
              title="Must be more than 8 characters, including number, lowercase letter, uppercase letter" />
          </label>
          <p class="validator-hint hidden">
            Must be more than 8 characters, including
            <br />At least one number <br />At least one lowercase letter <br />At least one uppercase letter
          </p>
        </td>
      </tr>
      <tr>
        <td align="center">
          <label class="label">
            <input data-action="change->register#inputChanged"
                   required
                   name="user[agreeToTermsAndConditions]"
                   type="checkbox"
                   class="checkbox" />
            I have read and accept the terms and conditions
          </label>
        </td>
      </tr>
      <tr>
        <td align="center">
          <input data-action="click->register#submit"
                 name="submitButton"
                 type="submit"
                 class="btn" />
        </td>
      </tr>
    </tbody>
  </table>
</form>

<style type="text/css">
  .white-rounded {
    background: #FEFEFE;
    border-radius: 20px;
  }
</style>
