<div class="overflow-x-auto margin-auto">
  <table class="table min-h-600">
    <tbody>
      <tr>
        <td>
          <div class="card w-96 bg-white shadow-sm">
            <div class="card-body">
              <span class="badge badge-xs badge-warning">
                <%= I18n.t('choose_plan.most_popular')%>
              </span>
              <div class="flex justify-between">
                <h2 class="text-3xl font-bold">
                  <%= I18n.t('choose_plan.premium_5GB.name')%>
                </h2>
                <span class="text-xl">
                  <%= I18n.t('choose_plan.premium_5GB.price')%>
                </span>
              </div>
              <ul class="mt-6 flex flex-col gap-2 text-xs">
                <li>
                  <%= render(partial: "icons/valid") %>
                  <span><%= I18n.t('choose_plan.premium_5GB.data') %></span>
                </li>
                <li>
                  <%= render(partial: "icons/valid") %>
                  <span><%= I18n.t('choose_plan.premium_5GB.users') %></span>
                </li>
                <li>
                  <%= render(partial: "icons/valid") %>
                  <span><%= I18n.t('choose_plan.premium_5GB.bandwidth') %></span>
                </li>
              </ul>
              <div class="mt-6">
                <a href="/register?user[payload]=eyJwbGFuIjoiNUdCIn0=">
                  <button class="btn btn-primary btn-block">
                    <%= I18n.t('choose_plan.buy_now') %>
                  </button>
                </a>
              </div>
            </div>
          </div>
