<div style="margin: auto;" class="overflow-x-auto">
  <div align="center" class="mt-8 pt-4">
    <ul class="steps">
      <li class="step step-neutral">
        <%= link_to I18n.t('steps.choose_plan'),
              plans_path,
              style: "text-decoration: underline;" %>
      </li>
      <li class="step step-neutral">
        <%= link_to I18n.t('steps.register'),
              register_path(user: { payload: Base64.encode64(local_assigns[:user][:payload].to_json) }),
              style: "text-decoration: underline;" %>
      </li>
      <li class="step step-neutral"><%= I18n.t('steps.validate') %></li>
      <li class="step"><%= I18n.t('steps.complete') %></li>
    </ul>
    <div class="m-10">
      <div role="alert" class="alert">
        <%= render(partial: "icons/info") %>
        <p>Please verify all the fields, to validate your account.</p>
      </div>
    </div>
    <%= form_with(method: :post,
                  url: confirmation_path,
                  id: "validateForm",
                  data: { turbo: true },
                  html: {
                    data: {
                      controller: "validate",
                      "validate-target": "validateForm"
                    }
                  }) do |_form| %>
      <div class="card w-96 bg-base-100 shadow-sm">
        <table class="table">
          <tbody>
            <% if local_assigns[:user][:payload].try(:[], :accountType) == "company" %>
              <tr>
                <td>
                  <label class="label"><%= I18n.t('form.register.company_name') %></label>
                </td>
                <td>
                  <%= local_assigns[:user][:payload].try(:[], :companyName) %>
                </td>
              </tr>
            <% elsif local_assigns[:user][:payload].try(:[], :accountType) == "person" %>
              <tr>
                <td>
                  <label class="label"><%= I18n.t('form.register.first_name') %></label>
                </td>
                <td>
                  <%= local_assigns[:user][:payload].try(:[], :firstName) %>
                </td>
              </tr>
              <tr>
                <td>
                  <label class="label"><%= I18n.t('form.register.last_name') %></label>
                </td>
                <td>
                  <%= local_assigns[:user][:payload].try(:[], :lastName) %>
                </td>
              </tr>
            <% end %>
            <tr>
              <td>
                <label class="label"><%= I18n.t('form.register.email_address') %></label>
              </td>
              <td>
                <%= local_assigns[:user][:payload].try(:[], :emailAddress) %>
              </td>
            </tr>
            <tr>
              <td>
                <label class="label"><%= I18n.t('form.register.address') %></label>
              </td>
              <td>
                <%= local_assigns[:user][:payload].try(:[], :address) %>
              </td>
            </tr>
            <tr>
              <td>
                <label class="label"><%= I18n.t('form.register.postal_code') %></label>
              </td>
              <td>
                <%= local_assigns[:user][:payload].try(:[], :postalCode) %>
              </td>
            </tr>
            <tr>
              <td>
                <label class="label"><%= I18n.t('form.register.city') %></label>
              </td>
              <td>
                <%= local_assigns[:user][:payload].try(:[], :city) %>
              </td>
            </tr>
            <tr>
              <td>
                <label class="label"><%= I18n.t('form.register.country') %></label>
              </td>
              <td>
                <%= local_assigns[:user][:payload].try(:[], :country) %>
              </td>
            </tr>
            <tr>
              <td>
                <label class="label"><%= I18n.t('form.register.plan') %></label>
              </td>
              <td>
                <%= local_assigns[:user][:payload].try(:[], :plan) %>
              </td>
            </tr>
          <tr>
            <td colspan="2" align="center">
              <input data-action="click->register#submit"
                     name="submitButton"
                     type="submit"
                     class="btn btn-neutral m-10" />
            </td>
          </tr>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
