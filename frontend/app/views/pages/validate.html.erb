<form class="overflow-x-auto"
      style="margin: auto;"
      id="registerForm"
      data-controller="register"
      data-register-target="registerForm">

  <ul class="steps">
    <li class="step step-neutral">
      <%= link_to I18n.t('steps.choose_plan'), plans_path, style: "text-decoration: underline;" %>
    </li>
    <li class="step step-neutral">
      <%= link_to I18n.t('steps.register'), register_path(plan: @plan), style: "text-decoration: underline;" %>
    </li>
    <li class="step step-neutral"><%= link_to I18n.t('steps.validate'), validate_path, style: "text-decoration: underline;" %></li>
    <li class="step"><%= I18n.t('steps.complete') %></li>
  </ul>

  <table class="table">
    <thead>
      <tr>
        <th>
        </th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
        </td>
      </tr>
    </tbody>
  </table>
</form>
