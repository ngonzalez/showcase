<div class="overflow-x-auto" style="margin: auto;">
  <table class="table">
    <tbody>
      <% if flash[:notice] %>
        <tr>
          <td>
            <h4 class="p-2" style="font-weight: bold;">
              <span><%= flash[:notice] %></span>
            </h4>
          </td>
        </tr>
      <% end %>
      <tr>
        <td align="center">
          <div class="hero bg-base-200 min-h-screen">
            <div class="hero-content text-center">
              <div class="max-w-md">
                <p class="text-5xl font-bold">
                  Web Publishing Services
                </p>
                <p class="py-6">
                  Premium offers: 5GB and 10GB of data hosted on cloud
                  <br />
                  Up to 3 and 10 users per account
                  <br />
                  Unlimited bandwitdth
                </p>
                <button class="btn btn-primary"><a href="/plans">Get Started</a>
          </button>
              </div>
            </div>
          </div>
        </td>
      </tr>
      <tr>
        <td class="w-96">
          <div class="join join-vertical bg-base-100 m-10">
            <div class="collapse collapse-arrow join-item border-base-300 border">
              <input type="radio" name="my-accordion-4" checked="checked" />
              <div class="collapse-title font-semibold">How do I create an account?</div>
              <div class="collapse-content text-sm">Click the "Get Started" button above and follow the registration process.</div>
            </div>
            <div class="collapse collapse-arrow join-item border-base-300 border">
              <input type="radio" name="my-accordion-4" />
              <div class="collapse-title font-semibold">I have questions on how the applications work. What should I do?</div>
              <div class="collapse-content text-sm">Click on "Documentation" on link in the top header.</div>
            </div>
            <div class="collapse collapse-arrow join-item border-base-300 border">
              <input type="radio" name="my-accordion-4" />
              <div class="collapse-title font-semibold">How do I update my profile information?</div>
              <div class="collapse-content text-sm">Go to "My Account" settings and select "Edit Profile" to make changes.</div>
            </div>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</div>
