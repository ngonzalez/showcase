<div class="overflow-x-auto" style="margin: 10px auto;">
  <table class="table">
    <tbody>
      <tr>
        <td align="center">
          <div class="hero bg-base-200 min-h-screen">
            <div class="hero-content text-center">
              <div class="max-w-md">
                <p class="text-5xl font-bold">
                  <%= I18n.t('home.service_name') %>
                </p>
                <p class="py-6">
                  <%= I18n.t('home.service_details').html_safe %>
                </p>
                <a href="/plans">
                  <button class="btn btn-primary">
                    <%= I18n.t('home.get_started') %>
                  </button>
                </a>
              </div>
            </div>
          </div>
        </td>
      </tr>
      <tr>
        <td class="w-96">
          <div class="join join-vertical bg-base-100 m-10">
            <div class="collapse collapse-arrow join-item border-base-300 border">
              <input type="radio" name="my-accordion-4" checked="checked" />
              <div class="collapse-title font-semibold">
                <%= I18n.t('home.questions_answers.question_1') %>
              </div>
              <div class="collapse-content text-sm">
                <%= I18n.t('home.questions_answers.answer_1').html_safe %>
              </div>
            </div>
            <div class="collapse collapse-arrow join-item border-base-300 border">
              <input type="radio" name="my-accordion-4" />
              <div class="collapse-title font-semibold">
                <%= I18n.t('home.questions_answers.question_2') %>
              </div>
              <div class="collapse-content text-sm">
                <%= I18n.t('home.questions_answers.answer_2').html_safe %>
              </div>
            </div>
            <div class="collapse collapse-arrow join-item border-base-300 border">
              <input type="radio" name="my-accordion-4" />
              <div class="collapse-title font-semibold">
                <%= I18n.t('home.questions_answers.question_3') %>
              </div>
              <div class="collapse-content text-sm">
                <%= I18n.t('home.questions_answers.answer_3').html_safe %>
              </div>
            </div>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</div>
