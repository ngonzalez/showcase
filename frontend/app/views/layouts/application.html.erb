<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Frontend" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Frontend">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "//fonts.googleapis.com/icon?family=Material+Icons" %>
    <%= stylesheet_link_tag "//fonts.googleapis.com/icon?family=Material+Symbols+Outlined" %>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.20.0/dist/axios.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%= render partial: "layouts/header" %>
    <%= render partial: "layouts/alerts" %>
    <main class="container mx-auto mb-10 flex">
      <%= yield %>
    </main>
    <%= render partial: "layouts/footer" %>
  </body>  
</html>
