<div class="drawer drawer-open"
     id="documentationPage"
     data-controller="documentation"
     data-documentation-target="documentationPage">

  <input id="drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content mt-4">
    <span name="container"></span>
    <div id="loading" align="center">
      <label class="text-base-content/70">Loading</label>
      <span class="loading loading-spinner text-neutral"></span>
    </div>
  </div>

  <div class="drawer-side">
    <label for="drawer" aria-label="close sidebar" class="drawer-overlay"></label>
    <div class="card">
      <div class="card-body">
        <ul id="documentationMenu" class="menu-sm shadow-sm white-bg m-8 p-4">
          <li data-action="click->documentation#clickSidebarMenu">
            <a href="#documentation-index" class="menu-link">
              <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                <div class="status status-primary animate-ping"></div>
                <div class="status status-primary"></div>
              </div>
              Index
            </a>
          </li>
          <li data-action="click->documentation#clickSidebarMenu">
            <a href="#desktop-application" class="menu-link">
              <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                <div class="status status-primary animate-ping"></div>
                <div class="status status-primary"></div>
              </div>
              Desktop Application
            </a>
          </li>
          <li>
            <ul>
              <li data-action="click->documentation#clickSidebarMenu">
                <a href="#quick-start" class="menu-link">
                  <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                    <div class="status status-primary animate-ping"></div>
                    <div class="status status-primary"></div>
                  </div>
                  Quick start
                </a>
              </li>
              <li>
                <details open>
                  <summary>macOS</summary>
                  <ul>
                    <li data-action="click->documentation#clickSidebarMenu">
                      <a href="#install-macos" class="menu-link">
                        <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                          <div class="status status-primary animate-ping"></div>
                          <div class="status status-primary"></div>
                        </div>
                        Install
                      </a>
                    </li>
                    <li>
                      <details open>
                        <summary>How to</summary>
                        <ul>
                          <li data-action="click->documentation#clickSidebarMenu">
                            <a href="#download-macos" class="menu-link">
                              <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                                <div class="status status-primary animate-ping"></div>
                                <div class="status status-primary"></div>
                              </div>
                              Download from the app store
                            </a>
                          </li>
                          <li data-action="click->documentation#clickSidebarMenu">
                            <a href="#authorize-macos" class="menu-link">
                              <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                                <div class="status status-primary animate-ping"></div>
                                <div class="status status-primary"></div>
                              </div>
                              Authorize the application
                            </a>
                          </li>
                        </ul>
                      </details>
                    </li>
                  </ul>
                </details>
              </li>
              <li>
                <details open>
                  <summary>Windows</summary>
                  <ul>
                    <li data-action="click->documentation#clickSidebarMenu">
                      <a href="#install-windows" class="menu-link">
                        <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                          <div class="status status-primary animate-ping"></div>
                          <div class="status status-primary"></div>
                        </div>
                        Install
                      </a>
                    </li>
                    <li>
                      <details open>
                        <summary>How to</summary>
                        <ul>
                          <li data-action="click->documentation#clickSidebarMenu">
                            <a href="#download-windows" class="menu-link">
                              <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                                <div class="status status-primary animate-ping"></div>
                                <div class="status status-primary"></div>
                              </div>
                              Download from the windows store
                            </a>
                          </li>
                          <li data-action="click->documentation#clickSidebarMenu">
                            <a href="#authorize-windows" class="menu-link">
                              <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                                <div class="status status-primary animate-ping"></div>
                                <div class="status status-primary"></div>
                              </div>
                              Authorize the application
                            </a>
                          </li>
                        </ul>
                      </details>
                    </li>
                  </ul>
                </details>
              </li>
            </ul>
          </li>
          <li data-action="click->documentation#clickSidebarMenu">
            <a href="#web-application" class="menu-link">
              <div aria-label="status-animated" class="inline-grid *:[grid-area:1/1]">
                <div class="status status-primary animate-ping"></div>
                <div class="status status-primary"></div>
              </div>
              Use the web application
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
